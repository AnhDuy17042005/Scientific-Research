<?xml version="1.0"?>
<!-- BASICS CONFIG FOR WORLD MAP -->
<sdf version="1.9">
  <world name="lidar_world">
    <!-- Gazebo systems required by the simulation and GPU LiDAR. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Simulation settings. -->
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Directional light. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Local ground plane: no external Gazebo Fuel model is required. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 14</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 14</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

<!-- BASICS CONFIG FOR WORLD MAP -->

    <model name="north_wall">
      <static>true</static>
      <pose>0 6.0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>12.0 0.10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.10 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -6.0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>12.0 0.10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.10 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>6.0 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.10 12.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 12.0 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-6.0 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.10 12.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 12.0 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

<!-- ===================================================== -->
<!-- INTERNAL ROOMS + CORRIDOR                              -->
<!-- World size: 20 m x 20 m                               -->
<!-- Main corridor: -1 m < y < 1 m                         -->
<!-- ===================================================== -->


<!-- ===================================================== -->
<!-- TOP WALL BETWEEN ROOMS AND CORRIDOR                    -->
<!-- ===================================================== -->

<!-- Left section -->
<model name="top_corridor_wall_left">
  <static>true</static>
  <pose>-4.85 1.0 0.5 0 0 0</pose>

  <link name="wall_link">

    <collision name="collision">
      <geometry>
        <box>
          <size>2.30 0.10 1.0</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>2.30 0.10 1.0</size>
        </box>
      </geometry>

      <material>
        <diffuse>0.80 0.80 0.80 1</diffuse>
      </material>
    </visual>

  </link>
</model>


<!-- Middle section -->
<model name="top_corridor_wall_middle">
  <static>true</static>
  <pose>0 1.0 0.5 0 0 0</pose>

  <link name="wall_link">

    <collision name="collision">
      <geometry>
        <box>
          <size>4.60 0.10 1.0</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>4.60 0.10 1.0</size>
        </box>
      </geometry>

      <material>
        <diffuse>0.80 0.80 0.80 1</diffuse>
      </material>
    </visual>

  </link>
</model>


<!-- Right section -->
<model name="top_corridor_wall_right">
  <static>true</static>
  <pose>4.85 1.0 0.5 0 0 0</pose>

  <link name="wall_link">

    <collision name="collision">
      <geometry>
        <box>
          <size>2.30 0.10 1.0</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>2.30 0.10 1.0</size>
        </box>
      </geometry>

      <material>
        <diffuse>0.80 0.80 0.80 1</diffuse>
      </material>
    </visual>

  </link>
</model>


<!-- ===================================================== -->
<!-- WALL BETWEEN ROOM 1 AND ROOM 2                         -->
<!-- ===================================================== -->

<model name="room1_room2_wall">
  <static>true</static>

  <!-- x y z roll pitch yaw -->
  <pose>0 3.5 0.5 0 0 0</pose>

  <link name="wall_link">

    <collision name="collision">
      <geometry>
        <box>
          <size>0.10 5.0 1.0</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>0.10 5.0 1.0</size>
        </box>
      </geometry>

      <material>
        <diffuse>0.80 0.80 0.80 1</diffuse>
      </material>
    </visual>

  </link>
</model>

  </world>
</sdf>
