<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lidar_world">
    <!-- Gazebo systems required by the simulation and GPU LiDAR. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Simulation settings. -->
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Directional light. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Local ground plane: no external Gazebo Fuel model is required. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 14</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 14</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

<!-- BASICS CONFIG FOR WORLD MAP -->

    <model name="north_wall">
      <static>true</static>
      <pose>0 6.0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>12.0 0.10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.10 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -6.0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>12.0 0.10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.10 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>6.0 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.10 12.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 12.0 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-6.0 0 0.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.10 12.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 12.0 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Maze layout adapted from maze1.sdf to the 12 m square.
         The lower cross walls leave a 1.7 m opening. -->
<model name="lower_west_wall">
  <static>true</static>
  <pose>-3.2 -4.25 0.5 0 0 0</pose>

  <link name="wall_link">

    <collision name="collision">
      <geometry>
        <box>
          <size>5.6 0.12 1.0</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>5.6 0.12 1.0</size>
        </box>
      </geometry>

      <material>
        <diffuse>0.80 0.80 0.80 1</diffuse>
      </material>
    </visual>

  </link>
</model>


<model name="lower_east_wall">
  <static>true</static>
  <pose>3.65 -4.25 0.5 0 0 0</pose>

  <link name="wall_link">

    <collision name="collision">
      <geometry>
        <box>
          <size>4.7 0.12 1.0</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>4.7 0.12 1.0</size>
        </box>
      </geometry>

      <material>
        <diffuse>0.80 0.80 0.80 1</diffuse>
      </material>
    </visual>

  </link>
</model>


    <!-- Upper cross walls create two side passages. -->
<model name="upper_west_wall">
  <static>true</static>
  <pose>-4.1 1.8 0.5 0 0 0</pose>

  <link name="wall_link">

    <collision name="collision">
      <geometry>
        <box>
          <size>3.8 0.12 1.0</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>3.8 0.12 1.0</size>
        </box>
      </geometry>

      <material>
        <diffuse>0.80 0.80 0.80 1</diffuse>
      </material>
    </visual>

  </link>
</model>


<model name="upper_east_wall">
  <static>true</static>
  <pose>3.75 1.5 0.5 0 0 0</pose>

  <link name="wall_link">

    <collision name="collision">
      <geometry>
        <box>
          <size>4.5 0.12 1.0</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>4.5 0.12 1.0</size>
        </box>
      </geometry>

      <material>
        <diffuse>0.80 0.80 0.80 1</diffuse>
      </material>
    </visual>

  </link>
</model>

<!-- The central divider is offset so the robot can spawn at (0, 0). -->
<model name="central_divider">
  <static>true</static>
  <pose>-0.6 2.4 0.5 0 0 0</pose>
  <link name="wall_link">
    <collision name="collision">
      <geometry><box><size>0.12 7.2 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.12 7.2 1.0</size></box></geometry>
      <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
    </visual>
  </link>
</model>

<model name="east_divider">
  <static>true</static>
  <pose>1.5 0.25 0.5 0 0 0</pose>
  <link name="wall_link">
    <collision name="collision">
      <geometry><box><size>0.12 2.5 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.12 2.5 1.0</size></box></geometry>
      <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
    </visual>
  </link>
</model>

<!-- Two northern branches reproduce the turns in maze1.sdf. -->
<model name="northwest_branch_wall">
  <static>true</static>
  <pose>-4.1 3.1 0.5 0 0 0</pose>
  <link name="wall_link">
    <collision name="collision">
      <geometry><box><size>0.12 2.6 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.12 2.6 1.0</size></box></geometry>
      <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
    </visual>
  </link>
</model>

<model name="northeast_branch_wall">
  <static>true</static>
  <pose>3.1 4.4 0.5 0 0 0</pose>
  <link name="wall_link">
    <collision name="collision">
      <geometry><box><size>0.12 3.2 1.0</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.12 3.2 1.0</size></box></geometry>
      <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
    </visual>
  </link>
</model>

  </world>
</sdf>
